# NextAuth. No modo local o app usa um segredo de demonstração se esta chave faltar.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=troque-esta-chave

# API de recomendação (POST /getData). Se estiver fora do ar, a tela
# "Monte sua festa" usa um catálogo local de demonstração.
NEXT_PUBLIC_API_URL=http://localhost:5000
